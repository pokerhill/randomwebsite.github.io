node_modules
.DS_Store
build/
.claude/

.shots/

# Raw flight CAD (URDF + STLs). This repo is PUBLIC — committing these would
# publish the full-resolution arm design. The site ships a pre-rendered frame
# sequence instead; see src/components/home/MissionCaptureLive.js.
robots/

# Arm models baked from robots/ by scripts/build-ora-model.js. They carry the
# exact joint chain plus simplified link meshes, so they expose the design the
# same way the CAD does. No build ships them — only the render pipeline reads
# them. Regenerate locally: node scripts/build-ora-model.js ORA_A1
src/assets/models/

# Figma fidelity harness output (regenerated by scripts/figma-diff.mjs)
figma-diff-out/
figma-refs/

# Proprietary flight/robot control code vendored in for local Isaac Sim testing.
# Not website content, and the same public-repo exposure risk as robots/.
ora_scripts/

# Throwaway Puppeteer verification scripts + ad-hoc screenshots from the Figma
# fidelity pass. Not shipped, not needed once verified.
scratch/

# Claude workflow planning docs (todo/lessons/design-spec) — not site content.
tasks/
